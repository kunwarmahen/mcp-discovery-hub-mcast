# Set to 'true' to enable debug print statements
DEBUG_LOGGING=false

# MCP Server Configuration
# =========================

# Server Name (shown in discovery)
MCP_SERVER_NAME="File System MCP Server"

# Server Port
MCP_SERVER_PORT=3002

# Authentication Settings
MCP_REQUIRE_AUTH=false
MCP_AUTH_TOKEN=holaamigo_namaste_adios_baby

# Broadcasting Settings
# Set to 'true' to enable UPnP/SSDP-style broadcasting
# Set to 'false' to disable broadcasting (server will only respond to direct scans)
MCP_ENABLE_BROADCAST=true

# Broadcast interval in seconds (how often to announce presence)
MCP_BROADCAST_INTERVAL=30


# MCP Discovery Hub Configuration
# =================================

# Enable passive discovery (listening for server broadcasts)
# Set to 'true' to listen for server announcements
# Set to 'false' to only use active scanning
MCP_ENABLE_PASSIVE_DISCOVERY=true


# Usage Examples:
# ===============
#
# Scenario 1: Broadcasting Server (Default)
# - MCP_ENABLE_BROADCAST=true
# - Server announces itself every 30 seconds
# - Discovery hub can find it automatically
#
# Scenario 2: Silent Server
# - MCP_ENABLE_BROADCAST=false
# - Server only responds to direct scans
# - Useful for private/secure environments
#
# Scenario 3: Passive Discovery Only
# - Hub: MCP_ENABLE_PASSIVE_DISCOVERY=true
# - Hub listens for broadcasts but doesn't scan
# - More efficient, less network traffic
#
# Scenario 4: Active Scanning Only
# - Hub: MCP_ENABLE_PASSIVE_DISCOVERY=false
# - Hub only finds servers through manual scans
# - Useful when broadcasting is disabled network-wide
